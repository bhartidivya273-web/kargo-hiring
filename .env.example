# Supabase: Project Settings > API. Use the SERVICE ROLE key (server-only, never exposed to the browser).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio key. Enable billing on the project so inputs are not used for training.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Resend. Without a verified domain, the sender must be onboarding@resend.dev
RESEND_API_KEY=
RESEND_FROM=Arjun Mehta <onboarding@resend.dev>
# Optional safety net: if set, every email goes here instead of the candidate's address.
EMAIL_TEST_OVERRIDE=

# Password for the dashboard (it is on a public URL and holds candidate PII).
DASHBOARD_PASSWORD=

# How many candidates per role sit above the line (get a brief + invite draft).
TOP_N=5
